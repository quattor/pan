object template main;
variable SOURCE = 2;
variable X = 1;
variable X = 2;
variable X ?= SOURCE;
variable U = undef;
variable U ?= 4;
variable N = null;
variable N ?= 5;
variable TEXT = 'null';
variable EMPTY = '';
variable DATA = list(nlist('key', list(10, 20)));
variable INDEX = 1;
variable FLAG = true;
variable OFF = false;
variable TARGET = 'leaf';
include 'functions';
include { TARGET; };
'/argument' = from_include(SOURCE);
'/indexed' = DATA[0]['key'][INDEX];
'/condition_true' = if (FLAG) SOURCE else OFF;
'/condition_false' = if (OFF) FLAG else SOURCE;
'/shadow' = { SOURCE = 99; SOURCE; };
'/before' = DATA;
variable DATA = { SELF[0]['key'][0] = 42; SELF; };
'/after' = DATA;
variable PATH = '/chosen';
'/chosen' = 'path-value';
'/path-read' = value(PATH);
'/null' = is_null(N);
